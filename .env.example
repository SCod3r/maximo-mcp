# Maximo MCP Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# Maximo API Configuration
MAXIMO_URL=https://your-maximo-host.com/maximo/api
MAXIMO_HOST=https://your-maximo-host.com
MAXIMO_API_KEY=your-api-key-here

# Optional: Path to local OpenAPI schema
MAXIMO_OPENAPI_PATH=./maximo_openapi.json

# --- Security settings (MCP server) ---
# Write tools (create_record, update_record, run_action) are OFF unless set to true.
MAXIMO_ENABLE_WRITES=false
# Optional allowlist of Object Structures the server may access (comma-separated). Empty = any.
MAXIMO_ALLOWED_OBJECT_STRUCTURES=
# Actions run_action may execute (comma-separated). Default: changeStatus
MAXIMO_ALLOWED_ACTIONS=changeStatus
# Maximum records per query (default 100)
MAXIMO_MAX_PAGE_SIZE=100

# --- Demo proxy server (server.js) ---
PORT=3002
# Interface to bind. Keep 127.0.0.1 unless you understand the risk of exposing the proxy.
HOST=127.0.0.1
# Only for test instances with self-signed certificates. Never enable for production.
MAXIMO_PROXY_INSECURE_TLS=false
