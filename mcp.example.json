{
    "mcpServers": {
        "maximo": {
            "command": "node",
            "args": [
                "/absolute/path/to/maximo-mcp/maximo-mcp-server.js"
            ],
            "env": {
                "MAXIMO_URL": "https://your-maximo-host.com/maximo/api",
                "MAXIMO_ENABLE_WRITES": "false"
            }
        }
    }
}
